{
  "name": "sharing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:worker": "tsx watch --env-file=.env src/worker/index.ts",
    "build": "pnpm check:boundaries && next build --webpack && tsc -p tsconfig.worker.json && pnpm check:client-assets",
    "start:web": "next start --hostname 127.0.0.1",
    "start:worker": "node --env-file=.env dist/worker/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --fileParallelism=false",
    "test:codex": "node scripts/verify-codex.mjs",
    "plugin:export": "node scripts/export-plugin.mjs",
    "plugin:cursor:install": "node scripts/install-cursor-plugin.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test:unit",
    "auth:generate": "auth generate --config scripts/auth-schema-config.ts --output src/server/db/auth-schema.ts --adapter drizzle --dialect postgresql --yes",
    "format": "prettier --write src scripts tests *.ts *.mjs",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:client-assets": "tsx scripts/check-client-assets.ts",
    "test:worker": "node scripts/verify-worker.mjs",
    "a4:validate": "node --env-file=.env --import tsx scripts/validate-a4.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@mozilla/readability": "0.6.0",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "jsdom": "30.1.1",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.6",
    "dotenv": "18.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
