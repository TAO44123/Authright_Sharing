# Local development only. Replace all secrets for any deployed environment.
DATABASE_URL=postgresql://sharing:sharing_local@127.0.0.1:55432/sharing
TEST_DATABASE_URL=postgresql://sharing:sharing_local@127.0.0.1:55432/sharing_test
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
CURSOR_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=authright.com
MCP_RESOURCE_URL=http://localhost:3000/mcp
# Keep false until both real providers are configured and samples reviewed.
# Turning it on consumes existing queued links as well as new submissions.
CONTENT_PROCESSING_ENABLED=false
# Gemini 3.5 Flash-Lite article summaries (server-side Worker only).
GEMINI_API_KEY=
# Match the Gemini API project's tier in AI Studio; required when processing is enabled.
GEMINI_BILLING_TIER=free
# YouTube Data API v3 (server-side only).
YOUTUBE_API_KEY=
WORKER_CONCURRENCY=2
SUMMARY_CONCURRENCY=1
LOG_LEVEL=info
