# Copy to /etc/sharing/lightsail.env on the server; never commit real values.
SHARING_DOMAIN=sharing.example.com
# Replace with sharing:<git short SHA> after building the application image.
SHARING_IMAGE=sharing:REPLACE_WITH_GIT_SHA
# Generate a hex password; use the identical value in DATABASE_URL below.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://sharing:REPLACE_WITH_RANDOM_HEX@postgres:5432/sharing
BETTER_AUTH_SECRET=REPLACE_WITH_FIRST_RANDOM_SECRET
CURSOR_SIGNING_SECRET=REPLACE_WITH_SECOND_RANDOM_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_WORKSPACE_DOMAIN=authright.com
CONTENT_PROCESSING_ENABLED=false
GEMINI_API_KEY=
GEMINI_BILLING_TIER=free
YOUTUBE_API_KEY=
WORKER_CONCURRENCY=2
SUMMARY_CONCURRENCY=1
LOG_LEVEL=info
